# Backend Environment Variables
PORT=3001
NODE_ENV=production

# Database - Local development uses db/database.sqlite, production uses persistent volume
DB_PATH=/app/data/database.sqlite

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# CORS - Frontend URL
CLIENT_URL=https://evoapi-frontend-url.ttvjwi.easypanel.host

# Security
BCRYPT_ROUNDS=12